# Example Environment Configuration
# Copy this file to .env and update values for your environment

# Application Settings
SECRET_KEY=your-super-secret-key-change-this-in-production-with-a-strong-random-key
DEBUG=False
ENVIRONMENT=production

# Database Configuration
# SQLite (development): sqlite:///./mechanical_app.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./mechanical_app.db
DB_USER=engineeringapp
DB_PASSWORD=change_this_password
DB_NAME=mechanical_app
DB_HOST=localhost
DB_PORT=5432

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Email Configuration (for future features)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Mobile App Settings
MOBILE_API_VERSION=v1
ENABLE_MOBILE_ANALYTICS=True

# Logging
LOG_LEVEL=INFO

# Database Backup
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily  # daily, weekly, monthly
